k8s {
  namespace = 'medgen-ns'
   runAsUser = 1000
   pod = [ [volumeClaim: 'pvc-cephfs', mountPath: "/cephfs" ]]
   homeDir = '/cephfs/cmbg/Mareckova_panel'
   launchDir = "${k8s.homeDir}/src/launch"
   projectDir = "${k8s.homeDir}/src/project"
   workDir = "${k8s.homeDir}/src/temp"
}

params {
   outDirectory = "${k8s.homeDir}/data"
   ref = '/cephfs/cmbg/references/Homo_sapiens/GATK/GRCh38/Sequence/WholeGenomeFasta/Homo_sapiens_assembly38'
   vep = '/cephfs/cmbg/references/Homo_sapiens/GATK/GRCh38/Annotation/vep'
   refindex = '/cephfs/cmbg/references/Homo_sapiens/GATK/GRCh38/Sequence/BWAIndex/Homo_sapiens_assembly38.fasta.64'
   covbed = "${k8s.projectDir}/kamilareblova/mareckova/beds/mareckovaBed_GRCh38.bed"
   variantsDBdir = "${k8s.projectDir}/kamilareblova/mareckova/beds"

   vcftbl = "${k8s.projectDir}/kamilareblova/mareckova/scripts/vcf2table108.py"
   coverstat = "${k8s.projectDir}/kamilareblova/mareckova/scripts/coverage_stat.R"
   mergetables = "${k8s.projectDir}/kamilareblova/mareckova/scripts/JoinVars.py"
}


executor {
   queueSize = 50
}


process {
   container = 'xreblova/svatmarckova'
   shell = ['/bin/bash', '-eo', 'pipefail']
   scratch = true
   executor = 'k8s'
   pod = [[securityContext:[fsGroupChangePolicy:'OnRootMismatch', allowPrivilegeEscalation:false, runAsUser:1000, capabilities:[drop:['ALL']]]], [nodeSelector:'storage=local-ssd']]
   // errorStrategy = { task.exitStatus in [143,137,104,134,139,247, null, ''] ? 'retry' : 'finish' }
   errorStrategy = "finish"

   cpus = 2
   memory = '12GB'
 
   withLabel:small_process {
         cpus = 1
         memory = 12.GB
      }
      withLabel:smallest_process {
         cpus = 2
         memory = 20.GB
      }   
      withLabel:medium_cpu {
         cpus = 4
      }
      withLabel:medium_mem {
         memory = 40.GB
      }  
}
